{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySql": "server=localhost; database=letstalk; user=root",
    "MongoDB": "mongodb://localhost:27017",
    "CosmosDB": "https://cosmosdb-letstalk.documents.azure.com:443/",
    "Redis": "localhost:6379"
  },
  "ApplicationUrls": {
    "Authentication": "https://127.0.0.1:5001",
    "Api": "https://127.0.0.1:5000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Kafka": {
    "Url": "127.0.0.1:9092"
  },
  "Topics": {
    "Notification": "letstalk-notification-topic",
    "LinkPreviewRequest": "letstalk-link-preview-request-topic",
    "ImageResizeRequest": "letstalk-image-resize-request-topic",
    "RemoveImageRequest": "letstalk-remove-image-request-topic",
    "SendEmailRequest": "letstalk-send-email-request-topic"
  },
  "KeepAlive": {
    "StartupDelay": "00:00:30",
    "Targets": {
      "Redis": {
        "Enabled": true,
        "Interval": "1.00:00:00"
      },
      "MongoDB": {
        "Enabled": true,
        "Interval": "1.00:00:00"
      }
    }
  },
  "ImageConstraints": {
    "ImagePreviewMaxWidth": 512,
    "ImagePreviewMaxHeight": 512
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "https://127.0.0.1:5000",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Messaging": {
    "MessagesPerPage": 20
  },
  "Caching": {
    "MessagesCacheLifeTimeInSeconds": 120,
    "ChatCacheLifeTimeInSeconds": 30,
    "AccountCacheLifeTimeInSeconds": 30,
    "ProfileCacheLifeTimeInSeconds": 30
  },
  "MongoDB": {
    "DatabaseName": "LetsTalk"
  },
  "CosmosDB": {
    "DatabaseName": "LetsTalk"
  },
  "Security": {
    "AntiSpamTokenLifeTimeInSeconds": 60
  },
  "Cloudflare": {
    "TokenTtl": 86400
  },
  "Features": {
    "DatabaseMode": "MySql",
    "CachingMode": "redis",
    "EventBrokerMode": "kafka",
    "LinkPreviewMode": "local",
    "ImageProcessingMode": "local",
    "Telemetry": "None"
  }
}
