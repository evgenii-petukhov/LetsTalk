{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Url": "127.0.0.1:9092",
    "GroupId": "1"
  },
  "Topics": {
    "ImageResizeRequest": "letstalk-image-resize-request-topic",
    "SetImageDimensionsRequest": "letstalk-set-image-dimensions-request-topic"
  },
  "Queues": {
    "ImageResizeRequest": "letstalk-image-resize-request-queue",
    "SetImageDimensionsRequest": "letstalk-set-image-dimensions-request-queue"
  },
  "ApplicationUrls": {
    "Api": "https://127.0.0.1:5000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "FileStorage": {
    "ImageFolder": "Images"
  },
  "Resilience": {
    "Http": {
      "MaxRetryAttempts": 3,
      "Delay": "00:00:01",
      "MaxDelay": "00:00:10",
      "AttemptTimeout": "00:00:30",
      "TotalTimeout": "00:01:40"
    }
  },
  "Features": {
    "EventBrokerMode": "kafka"
  }
}
