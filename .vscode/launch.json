{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to .NET",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Next: server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend-next"
        },
        {
            "name": "Next: browser",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend-next"
        }
    ]
}